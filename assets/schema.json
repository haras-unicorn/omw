{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Config",
  "description": "OMW configuration.",
  "type": "object",
  "properties": {
    "agents": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/AgentConfig"
      }
    },
    "endpoint": {
      "description": "Optional HTTP endpoint; when set, a server is started and the agents\ncan subscribe to it as models.",
      "anyOf": [
        {
          "$ref": "#/$defs/EndpointConfig"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "providers": {
      "description": "Named provider implementations.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/ImplConfig"
      },
      "default": {}
    },
    "runtime": {
      "description": "Named runtime implementations.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/ImplConfig"
      },
      "default": {}
    },
    "tooling": {
      "description": "Named tooling implementations.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/ImplConfig"
      },
      "default": {}
    }
  },
  "$defs": {
    "AgentConfig": {
      "description": "A single agent wiring itself to the globals above.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "runtime": {
          "description": "Which named runtime implementation this agent's brain uses.",
          "type": "string"
        },
        "script": {
          "description": "The agent's brain script.",
          "type": "string"
        }
      },
      "required": ["name", "runtime", "script"]
    },
    "EndpointConfig": {
      "description": "Optional HTTP endpoint configuration: starts an OpenAI-compatible chat\nserver through which each subscribed agent is addressable as a model.",
      "type": "object",
      "properties": {
        "listen": {
          "description": "Socket address to listen on, e.g. `\"127.0.0.1:8080\"` or\n`\"0.0.0.0:8080\"`. Hostnames (e.g. `\"localhost:8080\"`) are rejected at\nstartup.",
          "type": "string"
        }
      },
      "required": ["listen"]
    },
    "ImplConfig": {
      "description": "A single configured implementation: which kind plus opaque params.",
      "type": "object",
      "properties": {
        "kind": {
          "description": "Which implementation this is.",
          "type": "string"
        }
      },
      "additionalProperties": true,
      "required": ["kind"]
    }
  }
}
